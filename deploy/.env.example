APP_IMAGE=ghcr.io/darmozcs/tramitea-be:latest

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=<password de postgres>

# El MISMO valor que AUTH_SECRET en /opt/infra/services/tramitea/.env (front).
# Generar con: openssl rand -base64 48
AUTH_SECRET=<secreto compartido, minimo 32 caracteres>

# Modo de auth. Testing (este server): darmoz. Producción (Railway): local
# (o sin definir). Ver README, sección Autenticación.
AUTH_MODE=darmoz
DARMOZ_AUTH_PUBLIC_KEY_PATH=/app/keys/darmoz_public_key.pem
# UUID de la Application "Tramitea" en darmoz-auth (el mismo API_ID del front).
DARMOZ_AUTH_APPLICATION_ID=<api-id de Tramitea en darmoz-auth>
